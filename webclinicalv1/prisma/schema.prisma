generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserType {
  PROFESSIONAL
  RECEPTIONIST
  ADMIN
  PATIENT
}


enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}


enum PaymentStatus {
  PENDING
  PAID
  CANCELED
}

model Company {
  cnpj      String  @id @default(uuid())
  name     String  @unique
  users    User[]
  rooms    Room[]
  schedules Schedule[]
  ProfessionalRecord ProfessionalRecord[]
}

model User {
  cpf       String  @id
  name      String
  email     String  @unique
  password  String
  userType  UserType
  companyId String

  company   Company @relation(fields: [companyId], references: [cnpj], onDelete: Cascade)
  professional Professional? 
  patient   Patient? 
  roles     User_Role[]
}

model Profession {
  id   String  @id @default(uuid())
  name String  @unique
  professionals Professional[]
}




model Professional {
  id             String  @id @default(uuid())
  userCpf        String  @unique
  professionId   String
  schedules      Schedule[]
  ProfessionalRecord ProfessionalRecord[]

  user       User       @relation(fields: [userCpf], references: [cpf], onDelete: Cascade)
  profession Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
}

model Patient {
  id        String   @id @default(uuid())
  userCpf   String   @unique
  history   ProfessionalRecord[]
  schedules Schedule[]

  user User @relation(fields: [userCpf], references: [cpf], onDelete: Cascade)
}

model Room {
  id        String @id @default(uuid())
  name      String
  companyId String
  schedules Schedule[]

  company   Company @relation(fields: [companyId], references: [cnpj], onDelete: Cascade)
}

model Schedule {
  id             String          @id @default(uuid())
  date           DateTime
  status         AppointmentStatus @default(PENDING)
  paymentStatus  PaymentStatus  @default(PENDING)
  professionalId String
  patientId      String
  companyId      String
  roomId         String?

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [cnpj], onDelete: Cascade)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
}

model ProfessionalRecord {
  id             String  @id @default(uuid())
  patientId      String
  professionalId String
  companyId      String
  anamnesis      String
  comorbidities  String
  createdAt      DateTime @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [cnpj], onDelete: Cascade)
}

model Role {
  id    String  @id @default(uuid())
  name  String  @unique
  users User_Role[]
  permissions Role_Permission[]
  userType UserType
}

model Permission {
  id   String @id @default(uuid())
  name String @unique
  roles Role_Permission[]
}

model User_Role {
  userCpf String
  roleId  String

  user User @relation(fields: [userCpf], references: [cpf], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userCpf, roleId]) 
}

model Role_Permission {
  roleId       String
  permissionId String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId]) 
}